{
  "schema_version": 1,
  "input_corpus": "experiments/m1/results/development_corpus.jsonl",
  "output_directory": "experiments/m3/results",
  "limits_from_m0": {
    "records_per_bounded_sample": 32,
    "soft_sample_target_bytes": 1048576,
    "hard_sample_cap_bytes": 67108864,
    "cold_query_budget_ms": 20000,
    "process_memory_ceiling_bytes": 134217728
  },
  "croissant": {
    "enabled": true,
    "parse_mode": "standards_aligned"
  },
  "content_probe": {
    "max_records": 32,
    "diagnostic_type": "bounded_sample_digest"
  }
}
