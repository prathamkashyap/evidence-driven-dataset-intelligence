.DS_Store
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage
build/
dist/
*.egg-info/

# LaTeX build products from report compilation are not report source.
*.aux
*.log
*.toc
*.out
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz

# Cached or generated research artifacts are local by default; curated, frozen
# benchmark fixtures may be added deliberately in a later milestone.
# M8 human-evaluation capture files follow the same rule: raw exports and
# derived participant CSVs are intentionally gitignored, and the analysis
# summary is local-only (untracked). See docs/M8_RESEARCH_FINDINGS.md
# (artifact inventory). Do not whitelist participant data.
data/raw/*
!data/raw/.gitkeep
data/normalized/*
!data/normalized/.gitkeep
data/evidence/*
!data/evidence/.gitkeep
data/fingerprints/*
!data/fingerprints/.gitkeep
data/benchmarks/*
!data/benchmarks/.gitkeep
!data/benchmarks/m8_corpus_exclusions.md
!data/benchmarks/m8_benchmark_manifest.json
!data/benchmarks/m8_ground_truth_labels.json
!data/benchmarks/m8_corruption_fixtures.json
!data/benchmarks/m8_human_eval_selection.json
!data/benchmarks/m8_rubric.md
!data/benchmarks/m8_annotation_protocol.md
!data/benchmarks/m8_human_eval_protocol.md
!data/benchmarks/m8_human_eval_instrument.md
indexes/bm25/*
!indexes/bm25/.gitkeep
indexes/dense/*
!indexes/dense/.gitkeep
# The M2 build directory is indexes/retrieval/m2 (see configs/m2_retrieval.json).
# Only the small index provenance record is tracked; generated payloads are local.
indexes/retrieval/*
!indexes/retrieval/m2/metadata.json
experiments/m0/cache/*
!experiments/m0/cache/.gitkeep
