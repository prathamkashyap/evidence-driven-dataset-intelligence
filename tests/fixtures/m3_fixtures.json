      "cr": "http://mlcommons.org/croissant/"
    },
    "@type": "Dataset",
    "name": "rotten_tomatoes",
    "description": "Movie review sentiment dataset with binary labels.",
    "license": "https://opensource.org/licenses/MIT",
    "distribution": [
      {
        "@type": "cr:FileObject",
        "name": "train_parquet",
        "encodingFormat": "application/x-parquet"
      }
    ],
    "recordSet": [
      {
        "@type": "cr:RecordSet",
        "name": "default",
